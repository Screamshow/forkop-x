#!/usr/bin/env bash
set -euo pipefail

GITHUB_REPOSITORY="${SING_BOX_EXTENDED_REPOSITORY:-shtorm-7/sing-box-extended}"
MIRROR_ROOT="${MIRROR_ROOT:-/srv/mirror/public/forkop/sing-box-extended}"
LOCK_FILE="${SING_BOX_EXTENDED_LOCK_FILE:-/run/lock/sing-box-extended-mirror.lock}"

exec 9>"$LOCK_FILE"
flock -n 9 || { echo "sing-box-extended mirror sync is already running" >&2; exit 0; }

release_json="$(curl -fsSL --retry 3 "https://api.github.com/repos/$GITHUB_REPOSITORY/releases/latest")"
tag="$(jq -r '.tag_name // empty' <<< "$release_json")"
[[ "$tag" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ && "$tag" != *alpha* && "$tag" != *beta* && "$tag" != *-rc* ]] || exit 1

asset_pattern='\A(sing-box-extended_[A-Za-z0-9._+-]+_openwrt_[A-Za-z0-9._+-]+\.(apk|ipk)|sing-box-[A-Za-z0-9._+-]+-linux-[A-Za-z0-9-]+-compressed\.tar\.gz)\z'
release_json="$(jq -ce --arg pattern "$asset_pattern" '
    .assets |= map(select(.name | test($pattern)))
    | select(.assets | length == (unique_by(.name) | length))
    | select(.assets | any(.[]; .name | endswith(".apk"))
        and any(.[]; .name | endswith(".ipk"))
        and any(.[]; .name | endswith("-linux-arm64-compressed.tar.gz")))
    | select(.assets | all(.[]; ((.browser_download_url // "") | startswith("https://"))
        and ((.digest // "") | test("\\Asha256:[a-f0-9]{64}\\z"))))
' <<< "$release_json")" || {
    echo "Incomplete sing-box-extended release assets for $tag" >&2
    exit 1
}
checksums="$(jq -r '.assets[] | "\(.digest | sub("^sha256:"; ""))  ./\(.name)"' <<< "$release_json")"
manifest="$(jq --arg public_url "/forkop/sing-box-extended/releases/$tag/" '
    .html_url = $public_url
    | .assets |= map(.browser_download_url = ($public_url + .name))
' <<< "$release_json")"
destination="$MIRROR_ROOT/releases/$tag"
mkdir -p "$MIRROR_ROOT/releases"
if [[ -e "$destination" || -L "$destination" ]]; then
    # Upstream release notes and download counts can change after publication.
    asset_identity='{tag_name, assets: [.assets[] | {name, digest, browser_download_url}] | sort_by(.name)}'
    if [[ ! -d "$destination" || -L "$destination" ]] ||
       [[ "$(jq -cS "$asset_identity" "$destination/release.json")" != "$(jq -cS "$asset_identity" <<< "$manifest")" ]] ||
       ! (cd "$destination" && sha256sum --check --status <<< "$checksums"); then
        echo "Refusing to replace immutable sing-box-extended release $tag" >&2
        exit 1
    fi
else
    staging="$(mktemp -d "$MIRROR_ROOT/.${tag}.staging.XXXXXX")"
    trap 'rm -rf -- "$staging"' EXIT
    downloads="$(jq -r '.assets[] | [.name, .browser_download_url] | @tsv' <<< "$release_json")"
    while IFS=$'\t' read -r name url; do
        curl -fsSL --retry 3 "$url" -o "$staging/$name"
    done <<< "$downloads"
    printf '%s\n' "$checksums" > "$staging/SHA256SUMS"
    (cd "$staging" && sha256sum --check SHA256SUMS)
    printf '%s\n' "$manifest" > "$staging/release.json"
    chmod 0755 "$staging"
    mv -nT "$staging" "$destination"
    if [[ -d "$staging" ]]; then
        echo "sing-box-extended release $tag already exists" >&2
        exit 1
    fi
fi

cp "$destination/release.json" "$MIRROR_ROOT/latest.json.new"
mv -T "$MIRROR_ROOT/latest.json.new" "$MIRROR_ROOT/latest.json"
printf '%s\n' "$tag" > "$MIRROR_ROOT/LATEST.new"
mv -T "$MIRROR_ROOT/LATEST.new" "$MIRROR_ROOT/LATEST"
echo "sing-box-extended $tag mirror sync completed"
