#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=99
USE_PROCD=1
EXTRA_COMMANDS="retry_start_on_wan_up handle_wan_up"
EXTRA_HELP="        retry_start_on_wan_up Retry failed cold start after WAN comes up\n        handle_wan_up Reload or retry after monitored WAN comes up\n"

script=$(readlink "$initscript")
NAME="$(basename ${script:-$initscript})"
FORKOP_LIB="/usr/lib/forkop"
FORKOP_INITD_UC="$FORKOP_LIB/service/initd.uc"

# FORKOP_LIB is deliberately not exported: service/initd.uc resolves the
# precompiled library cache itself and hands the result to everything it starts.
# Pinning the source directory here would reach every child through the
# environment and switch the whole procd path back to parsing sources.
initd_ucode() {
    [ -r "$FORKOP_INITD_UC" ] || return 1
    FORKOP_SERVICE_NAME="$NAME" \
        ucode -L "$FORKOP_LIB" "$FORKOP_INITD_UC" "$@"
}

sync_service_triggers() {
    _procd_call sync_service_triggers_payload
}

sync_service_triggers_payload() {
    json_init
    json_add_string name "$NAME"
    service_triggers
    _procd_ubus_call set >/dev/null 2>&1 || true
}

start_dns_watchdog() {
    # This worker deliberately lives in Forkop's procd service, not in the
    # sing-box service it observes.  It can therefore restore dnsmasq when
    # sing-box was stopped separately or cannot be respawned.
    procd_open_instance "dns-watchdog"
    procd_set_param command ucode -L "$FORKOP_LIB" "$FORKOP_LIB/service/watchdog.uc"
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

start_service() {
    # rcS/procd keeps its service transaction on fd 1000. Forkop starts and
    # verifies the separate sing-box procd service, so doing the full workflow
    # inside that transaction deadlocks nested service control until procd's
    # timeout. Detach the tracked worker and let rcS continue; LuCI reports the
    # action as "starting" until service/initd.uc completes it.
    if [ -e "/proc/$$/fd/1000" ]; then
        initd_ucode start-service "$1" "$$" </dev/null >/dev/null 2>&1 1000>&- &
        FORKOP_LAST_START_STATUS=0
        start_dns_watchdog
        return 0
    fi

    initd_ucode start-service "$1" "$$"
    FORKOP_LAST_START_STATUS="$?"

    [ "$FORKOP_LAST_START_STATUS" -ne 0 ] || start_dns_watchdog

    return "$FORKOP_LAST_START_STATUS"
}

service_started() {
    return "${FORKOP_LAST_START_STATUS:-0}"
}

disable() {
    # A failed start schedules a delayed retry.  Removing only the rc.d link
    # leaves that worker alive, so an explicit disable must cancel it first.
    [ -n "${IPKG_INSTROOT:-}" ] || initd_ucode cancel-scheduled-start-retry >/dev/null 2>&1 || true

    local name
    name="$(basename "$initscript")"
    rm -f "$IPKG_INSTROOT"/etc/rc.d/S??"$name"
    rm -f "$IPKG_INSTROOT"/etc/rc.d/K??"$name"
}

restart() {
    # rc.common's default stop/start restores upstream DNS between phases.
    # Retain the registered watchdog and use the single runtime transition.
    if initd_ucode status-service >/dev/null 2>&1; then
        initd_ucode restart-service "$$"
    else
        start
    fi
}

stop_service() {
    initd_ucode stop-service "$$"
    local status="$?"
    # rc.common calls procd_kill even when stop_service returns an error.
    # Abort this invocation when Stop fails so procd does not unregister a
    # still-running Forkop service and report success.
    [ "$status" -eq 0 ] || exit "$status"
}

reload_service() {
    local reason="$1"
    local result status

    trap 'initd_ucode reload-release >/dev/null 2>&1 || true' INT TERM
    result="$(initd_ucode reload-service "$reason" "$$")"
    status="$?"
    trap - INT TERM

    case "$result" in
        sync)
            sync_service_triggers
            ;;
        # Keep the queue acknowledgement visible to the list worker.  It
        # distinguishes accepted-but-not-applied list-content from a completed
        # lifecycle and retains its durable local apply marker accordingly.
        queued)
            printf '%s\n' queued
            ;;
    esac
    return "$status"
}

status_service() {
    initd_ucode status-service
}

retry_start_on_wan_up() {
    initd_ucode retry-start-on-wan-up "$$"
}

handle_wan_up() {
    initd_ucode handle-wan-up "$$"
}

service_triggers() {
    local plan kind event target init action reason

    plan="$(initd_ucode trigger-plan)" || return 0

    procd_open_trigger
    while IFS="$(printf '\t')" read -r kind event target init action reason; do
        case "$kind" in
        delay)
            PROCD_RELOAD_DELAY="$event"
            ;;
        config)
            procd_add_config_trigger "$event" "$target" "$init" "$action" "$reason"
            ;;
        interface)
            if [ -n "$reason" ]; then
                procd_add_interface_trigger "$event" "$target" "$init" "$action" "$reason"
            else
                procd_add_interface_trigger "$event" "$target" "$init" "$action"
            fi
            ;;
        esac
    done << EOF
$plan
EOF
    procd_close_trigger
}
