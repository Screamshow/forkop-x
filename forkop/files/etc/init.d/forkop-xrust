#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99

# Forkop publishes a checked config path before starting this procd service.
boot() { return 0; }
enable() { return 0; }

start_service() {
    local config_file workdir
    IFS= read -r config_file < /var/run/forkop/xrust-config-path || return 1
    [ -r "$config_file" ] || return 1
    [ -x /usr/bin/xrust ] || return 1
    config_load forkop
    config_get workdir settings xrust_workdir /usr/share/xrust
    mkdir -p "$workdir" || return 1
    procd_open_instance client
    procd_set_param command /usr/bin/xrust run -c "$config_file" -D "$workdir"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="1000000 1000000"
    procd_set_param respawn
    procd_close_instance
}
